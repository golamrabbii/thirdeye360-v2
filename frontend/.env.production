# Production build env — baked into the bundle at build time (rebuild after changes!)
# v2 frontend lives at streetview.bmapsbd.com/v2 (nginx location /v2/ → port 3005)
# v2 backend is mapped at /api/v2 (nginx → 127.0.0.1:8002)
NEXT_PUBLIC_API_BASE_URL=https://streetview.bmapsbd.com/api/v2
NEXT_PUBLIC_API_URL=https://streetview.bmapsbd.com/api/v2
NEXT_PUBLIC_IMAGE_CANDIDATE_HOSTS=https://streetview.bmapsbd.com
