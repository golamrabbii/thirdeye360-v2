# Production build env — baked into the bundle at build time (rebuild after changes!)
# The backend has NO root_path: nginx (location /api/ + trailing-slash proxy_pass)
# strips one /api/, so the app serves /api/features etc. directly.
# The frontend appends /api/... itself → public calls are /api/api/... (same shape as v1).
NEXT_PUBLIC_API_BASE_URL=https://streetview.bmapsbd.com/api
NEXT_PUBLIC_API_URL=https://streetview.bmapsbd.com/api
NEXT_PUBLIC_IMAGE_CANDIDATE_HOSTS=https://streetview.bmapsbd.com
