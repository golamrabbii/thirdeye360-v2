# Template for the production build of the frontend.
# Copy to .env.production BEFORE running `npm run build` —
# NEXT_PUBLIC_* values are baked into the bundle at build time.

# Replace <SERVER_IP_OR_DOMAIN> with the deployed server's public hostname/IP.
NEXT_PUBLIC_API_BASE_URL=http://<SERVER_IP_OR_DOMAIN>:8001/api
NEXT_PUBLIC_API_URL=http://<SERVER_IP_OR_DOMAIN>:8001/api
NEXT_PUBLIC_IMAGE_CANDIDATE_HOSTS=https://streetview.bmapsbd.com
