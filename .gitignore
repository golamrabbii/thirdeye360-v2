# ---- Secrets (NEVER commit) ----
.env
.env.local
.env*.local

# ---- Python ----
__pycache__/
*.py[cod]
venv/
.venv/
tmp/
logs/
*.log
*.pid

# ---- Node / Next.js ----
node_modules/
.next/
out/

# ---- Large data (GitHub hard-rejects files > 100MB) ----
backend/features.geojson

# ---- Runtime / user data ----
backend/r2_cache/
backend/uploads/*
backend/temp_uploads/*
backend/tiledata/*
!backend/uploads/.gitkeep
!backend/temp_uploads/.gitkeep
!backend/tiledata/.gitkeep

# ---- OS / editor ----
.DS_Store
Thumbs.db

# ---- Patch / backup artifacts ----
*.bak
*.rej
*.orig
